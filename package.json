{
  "name": "virelo-web",
  "version": "0.1.0",
  "description": "A private, browser-only video library for local files.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "typecheck": "tsc -p tsconfig.web.json",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "client-side",
    "file-system-access-api",
    "virelo",
    "video",
    "streaming",
    "media-library",
    "pwa"
  ],
  "author": "Riyoway",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VireloHQ/Virelo-Web.git"
  },
  "bugs": {
    "url": "https://github.com/VireloHQ/Virelo-Web/issues"
  },
  "homepage": "https://virelo.riyo.me",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.2",
    "@mediabunny/aac-encoder": "^1.61.4",
    "@mediabunny/ac3": "^1.61.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "matroska-subtitles": "^3.3.2",
    "mediabunny": "^1.61.4",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
